# Anvil Ops — local development example.
# Copy to .env for `wrangler dev` (never commit the real file).

# Shown in the UI and used by the platform itself.
APP_NAME="Anvil Ops"
APP_ENV="development"

# ---------------------------------------------------------------------------
# Platform secrets.
# These are NOT read from .env when deployed: set them with `wrangler secret put`
# (or Sites → Secrets). Never commit real values and never expose them to clients.
# ---------------------------------------------------------------------------

# Optional: SMTP/API key for a transactional email provider, if you add outbound
# email notifications later. The platform currently records communication; it does
# not send email on your behalf.
# EMAIL_PROVIDER_API_KEY=

# Optional: deployment-provider tokens used by server-side integrations
# (e.g. reading build status from Vercel or GitHub). Never send these to a browser.
# VERCEL_TOKEN=
# GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Bindings (configured in wrangler.jsonc, not in .env):
#   DB    → D1 database  (local: .wrangler/state)
#   FILES → R2 bucket    (local: .wrangler/state)
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Website integrations (set in EACH client website's environment, not here).
# Issue per-website credentials in the dashboard: Websites → Integration.
#   ANVIL_API_URL=https://your-platform-host
#   ANVIL_TOKEN=wxi_xxxxxxxx.yyyyyyyyyyyyyyyy
#   ANVIL_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxx
# The token must never appear in client-side JavaScript.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Test suite (scripts/test-api.mts)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@anvil.test"
ADMIN_PASSWORD="AnvilOps-2026!"
# BASE_URL="http://127.0.0.1:3000"
