// Embeds src/db/schema.sql so the Node/Vercel runtime can create the schema
// without a filesystem: serverless bundles do not reliably include .sql files.
// Run `npm run db:embed-schema` after editing the schema.

import { readFileSync, writeFileSync } from 'node:fs';

const sql = readFileSync('src/db/schema.sql', 'utf8');
const output =
  '// Generated by scripts/embed-schema.mts from src/db/schema.sql — do not edit.\n' +
  '// Used by src/node/schema.ts to bootstrap an empty Node/Vercel database.\n\n' +
  `export const SCHEMA_SQL: string = ${JSON.stringify(sql)};\n`;

writeFileSync('src/db/schema-sql.ts', output);
console.log(`src/db/schema-sql.ts written (${sql.length} bytes of SQL)`);
