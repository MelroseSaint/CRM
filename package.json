{
  "name": "anvil-ops",
  "version": "1.0.0",
  "private": true,
  "description": "Anvil Ops \u2014 studio operations platform (React + Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 3000 --ip 0.0.0.0 --local",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "web:install": "npm --prefix web install --no-audit --no-fund",
    "db:init": "wrangler d1 execute anvil-ops --local --file=src/db/schema.sql",
    "db:init:remote": "wrangler d1 execute anvil-ops --remote --file=src/db/schema.sql",
    "db:demo": "wrangler d1 execute anvil-ops --local --file=scripts/demo.sql",
    "typecheck": "tsc --noEmit && npm --prefix web run typecheck",
    "test": "npm run typecheck && npm run test:api",
    "test:api": "node scripts/test-api.mts",
    "sdk:build": "cd sdk && npm install --no-audit --no-fund && npm run build",
    "sdk:typecheck": "cd sdk && npm install --no-audit --no-fund && npm run typecheck"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.20.0"
  }
}
